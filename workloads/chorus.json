{
  "schema": "gadra-workload/v2",
  "model": "Chorus",
  "datasets": [
    "scannet",
    "scannetpp",
    "matterport3d"
  ],
  "external_model": "local/workloads/repos/Chorus",
  "dataset_roots": {
    "scannet": "local/workloads/data/scannet",
    "scannetpp": "local/workloads/data/scannetpp",
    "matterport3d": "local/workloads/data/matterport3d"
  },
  "capture_dir": "local/captures/chorus",
  "config": "configs/chorus_scannet.json",
  "base_config": "configs/chorus_single64_base.json",
  "prepare": "python scripts/prepare_chorus_scannet.py --manifest local/study.json --phase capture --role test",
  "reproduce": "python scripts/reproduce_chorus_scannet.py --manifest local/study.json --output results/paper/chorus",
  "quality": {
    "metrics": [
      "mIoU",
      "mAcc"
    ],
    "aggregation": "original-position scene confusion matrices"
  },
  "study_manifest": "local/study.json",
  "hardware_profile": "paper-v1"
}
