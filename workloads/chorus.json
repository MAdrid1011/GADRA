{
  "schema": "gadra-workload/v1",
  "model": "Chorus",
  "datasets": ["scannet", "scannetpp", "matterport3d"],
  "external_model": "local/workloads/repos/Chorus",
  "dataset_roots": {"scannet": "local/workloads/data/scannet", "scannetpp": "local/workloads/data/scannetpp", "matterport3d": "local/workloads/data/matterport3d"},
  "capture_dir": "local/captures/chorus",
  "config": "configs/chorus_scannet.json",
  "base_config": "configs/chorus_single64_base.json",
  "prepare": "python scripts/prepare_chorus_scannet.py --repeats 7",
  "reproduce": "python scripts/reproduce_chorus_scannet.py --dataset all --workers 4",
  "quality": {"min_class_agreement": 0.99, "max_regret": 0.01, "min_within_tolerance": 0.99}
}
